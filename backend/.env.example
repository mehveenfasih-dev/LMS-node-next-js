NODE_ENV=development
PORT=5000

# Browser origin(s) allowed by CORS. Comma-separated, exact origins, no trailing slash.
CLIENT_ORIGIN=http://localhost:3000

# Choose the backend database adapter. SQL Server is implemented today.
# MongoDB is an extension point; selecting it fails until its provider adapter is added.
DB_PROVIDER=sqlserver

# Used by the SQL Server provider.
DATABASE_URL="sqlserver://localhost:1433;database=library;user=sa;password=...;encrypt=true;trustServerCertificate=true"

# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=ed2c46949d806bc28983f0916ce8e0ad7ed66e537eedddff4967d1c7b67eadfff1dedde8f043ba6adadd1573b2534a6a
SESSION_DAYS=7
LOAN_PERIOD_DAYS=14

# Shared secret for Next.js -> backend "Sign in with Google" (POST /auth/google). Must match BACKEND_INTERNAL_KEY in Next.js.
INTERNAL_API_KEY=

# Optional: lets the backend purge the Next.js catalog cache after book/request changes.
NEXT_REVALIDATE_URL=http://localhost:3000
REVALIDATION_SECRET_TOKEN=
