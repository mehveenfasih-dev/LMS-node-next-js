NODE_ENV=development
PORT=5000

# Browser origin(s) allowed by CORS. Comma-separated, exact origins, no trailing slash.
CLIENT_ORIGIN=http://localhost:3000

# Select the backend database. Next.js uses external mode to call this Express API.
DB_PROVIDER=sqlserver

# Used by SQL Server when DB_PROVIDER=sqlserver.
DATABASE_URL="sqlserver://localhost:1433;database=library;user=sa;******;encrypt=true;trustServerCertificate=true"

# Used by MongoDB when DB_PROVIDER=mongodb. Local MongoDB must be a replica set
# (transactions are required); MongoDB Atlas URIs are supported.
MONGODB_URI=mongodb://127.0.0.1:27017/?replicaSet=rs0
MONGODB_DATABASE=lms
MONGODB_MAX_POOL_SIZE=10

# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=ed2c46949d806bc28983f0916ce8e0ad7ed66e537eedddff4967d1c7b67eadfff1dedde8f043ba6adadd1573b2534a6a
SESSION_DAYS=7
LOAN_PERIOD_DAYS=14

# Optional shared secret for short-lived Socket.IO tickets. When unset, JWT_SECRET is reused.
# Use the same value in Next.js internal mode and keep it at least 32 characters long.
SOCKET_AUTH_SECRET=af4f5259f2e62e98610b1e9e0aac6109bbfc6e3e7bc0ab4ba30c20ab83bdda96

# Optional initial administrator. Create it with `npm run db:seed:admin`.
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=
INITIAL_ADMIN_NAME="Library Admin"

# Shared secret for Next.js -> backend "Sign in with Google" (POST /auth/google). Must match BACKEND_INTERNAL_KEY in Next.js.
INTERNAL_API_KEY=

# Optional: lets the backend purge the Next.js catalog cache after book/request changes.
NEXT_REVALIDATE_URL=http://localhost:3000
REVALIDATION_SECRET_TOKEN=
